# Copy to .env and adjust values. Never commit real credentials.

# PostgreSQL credentials (used by docker-compose)
POSTGRES_USER=fraud
POSTGRES_PASSWORD=changeme
POSTGRES_DB=fraud_detection
POSTGRES_PORT=5432

# Full SQLAlchemy URL used by the backend container
DATABASE_URL=postgresql+psycopg2://fraud:changeme@db:5432/fraud_detection

# For local development without Docker, point at your local PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://fraud:changeme@localhost:5432/fraud_detection
# Or fall back to SQLite (default when DATABASE_URL is unset):
# DATABASE_URL=sqlite:///./data/fraud.db

# Connection pool (PostgreSQL)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE_SECONDS=1800

# Model artifacts
MODEL_PATH=./ml/artifacts/model.joblib
METADATA_PATH=./ml/artifacts/metadata.json

# CORS (JSON array of origins -- pydantic-settings parses lists as JSON)
ALLOWED_ORIGINS=["http://localhost:5173"]
